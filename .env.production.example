# TEMPLATE ONLY. Store the completed file outside Git; chmod 600.
# Start from the deployment guide. These placeholders intentionally cannot run.
ENVIRONMENT=production
DEBUG=false
DEMO_MODE=false
SECRET_KEY=REPLACE_WITH_AT_LEAST_48_RANDOM_BYTES
CORS_ORIGINS=["https://learn.example.com"]
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160
DATABASE_URL=postgresql+psycopg2://trainu:REPLACE@db.internal:5432/trainu?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
REDIS_URL=rediss://default:REPLACE@redis.internal:6379/0?ssl_cert_reqs=required
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_ASSISTANT_PER_MINUTE=30
CELERY_TASK_ALWAYS_EAGER=false
CELERY_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=20
API_WORKERS=2
S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
S3_PUBLIC_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=REPLACE_WITH_SCOPED_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_SCOPED_SECRET
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
S3_USE_SSL=true
# Conservative initial ceilings. Load-test larger uploads before raising.
MAX_VIDEO_SIZE_MB=250
MAX_DOCUMENT_SIZE_MB=25
STT_PROVIDER=whisper_api
STT_API_BASE_URL=https://api.openai.com/v1
STT_API_KEY=REPLACE
STT_MODEL=whisper-1
# Provider payload ceiling determines this; 10 minutes of mono 16 kHz PCM is ~19.2 MB.
STT_AUDIO_SEGMENT_SECONDS=600
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=REPLACE
LLM_MODEL=gpt-4o-mini
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=REPLACE
EMBEDDINGS_MODEL=text-embedding-3-small
# Schema is VECTOR(384); do not change without a migration + re-embedding.
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.2
RAG_HIGH_CONFIDENCE_SIMILARITY=0.55
RAG_MEDIUM_CONFIDENCE_SIMILARITY=0.30
# Compose interpolation; use tested image digests for a release.
TRAINU_API_IMAGE=registry.example.com/trainu/api@sha256:REPLACE
TRAINU_FRONTEND_IMAGE=registry.example.com/trainu/frontend@sha256:REPLACE
TRAINU_ENV_FILE=.env.production
FRONTEND_PORT=8080
