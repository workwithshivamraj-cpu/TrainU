# Copy this file to .env and adjust as needed. Defaults below work out of
# the box for `docker compose up` with no paid services or API keys.

# --- App ---
APP_NAME=TrainU
ENVIRONMENT=local
DEBUG=true

# --- Security ---
# Generate a real random value for anything beyond local demo use, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# --- CORS (comma-separated origins the Angular app is served from) ---
CORS_ORIGINS=["http://localhost:4300","http://127.0.0.1:4300","http://localhost:4200"]

# --- Database (docker-compose overrides the host to `postgres`; these are
# used when running the backend outside Docker, e.g. `uvicorn` locally) ---
POSTGRES_USER=trainu
POSTGRES_PASSWORD=trainu
POSTGRES_DB=trainu
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://trainu:trainu@localhost:5432/trainu

# --- Redis / Celery ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- Object storage (RustFS S3-compatible server locally; S3 endpoint in prod) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=trainu_admin
S3_SECRET_KEY=trainu_admin_secret
S3_BUCKET=trainu-media
S3_USE_SSL=false

# --- Upload limits ---
MAX_VIDEO_SIZE_MB=1024
MAX_DOCUMENT_SIZE_MB=50

# --- Speech-to-text provider: mock (default, no credentials) | whisper_api ---
STT_PROVIDER=mock
STT_API_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
# Local POC target; the image/provider must use an immutable hub commit ID
# before downloading. CPU INT8 is the default, with optional CUDA for tested hosts.
WHISPER_MODEL_ID=dropbox-dash/faster-whisper-large-v3-turbo
WHISPER_MODEL_REVISION=0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
# 10-minute mono PCM segments keep transcription payload sizes predictable.
STT_AUDIO_SEGMENT_SECONDS=600

# --- LLM + embeddings provider: mock (default) | openai | ollama ---
# For openai: set *_BASE_URL=https://api.openai.com/v1 and *_API_KEY.
# For ollama: set *_BASE_URL=http://localhost:11434/v1 (no key needed).
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Local Qwen2.5 7B Q4_K_M profile lock observed on the POC host.
LLM_MODEL_DIGEST=845dbda0ea48ed749caafd9e6037047aa19acfcfd82e704d7ca97d631a0b697e
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_MAX_TOKENS=768
LLM_SEED=42

EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64

# --- RAG tuning ---
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.2
RAG_HIGH_CONFIDENCE_SIMILARITY=0.55
RAG_MEDIUM_CONFIDENCE_SIMILARITY=0.30

# --- Rate limiting ---
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_ASSISTANT_PER_MINUTE=30

# --- Ports for the app services themselves ---
BACKEND_PORT=8000
FRONTEND_PORT=4200

DEMO_MODE=true

# The development Compose profile uses a shared Redis limiter.
RATE_LIMIT_BACKEND=auto
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
API_WORKERS=2
CELERY_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=20
